# Deployment owner — the account that is treated as the first admin.
# Never commit a real address here; set it in .env.local or your host env vars.
VITE_OWNER_EMAIL=
VITE_OWNER_NAME=

# Branding. Left empty on purpose: a fresh deployment carries no product name
# until you give it one, here or in הגדרות → מיתוג.
VITE_APP_NAME=
VITE_APP_LOGO_URL=
